{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  'pre-commit': {
    enabled: true,
  },
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      description: 'Group pre-commit hook and tflint plugin updates into one PR',
      matchManagers: [
        'pre-commit',
        'tflint-plugin',
      ],
      groupName: 'lint tooling',
    },
    {
      description: 'Group terraform-aws-modules IAM updates together',
      matchDatasources: [
        'terraform-module',
      ],
      groupName: 'terraform-aws-modules/iam',
      matchPackageNames: [
        '/terraform-aws-modules/iam/',
      ],
    },
  ],
}
